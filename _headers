# Cloudflare Workers static-assets header rules.
# Syntax: a URL pattern, then indented "Name: value" lines.

/*
  # Force HTTPS for two years, including subdomains.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Stop browsers guessing content types (blocks a class of injection attacks).
  X-Content-Type-Options: nosniff
  # Disallow framing, so the site cannot be used for clickjacking.
  X-Frame-Options: DENY
  # Send only the origin to third parties, never full paths or query strings.
  Referrer-Policy: strict-origin-when-cross-origin
  # The site needs none of these; deny them explicitly.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  # Content Security Policy.
  #   'unsafe-inline' is required because the pages use inline styles/handlers
  #   and inline <script> for gtag and the video loader.
  #   googletagmanager/google-analytics: GA4.  api.web3forms.com: form posts.
  #   fonts.googleapis.com + fonts.gstatic.com: Inter / Outfit / Cairo / Tajawal.
  #   cloudflareinsights.com: the Web Analytics beacon Cloudflare injects into
  #   every response — omit it and the proxy's own script is blocked.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com https://static.cloudflareinsights.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; media-src 'self'; frame-src https://www.google.com https://maps.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; object-src 'none'; upgrade-insecure-requests

# Fingerprinted assets (?v=N) and media never change in place — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iconicmach",
  "compatibility_date": "2026-05-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Serve /404.html instead of an empty body on unknown URLs.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
